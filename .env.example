# ──────────────────────────────────────────────────────────────
# Hilbras Studio — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────

# Session signing secret (HS256). Generate: openssl rand -hex 32
AUTH_SECRET=

# Master key for encrypting user OAuth tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
# WARNING: rotating this invalidates every stored platform token.
# Every environment that shares this database (local + Vercel) must use the
# SAME key, or each side can only decrypt the rows it wrote itself.
ENCRYPTION_KEY=

# PostgreSQL connection string (Supabase → Settings → Database → URI)
# Use the Session mode pooler URL (not the direct db.* URL):
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

# Public base URL of the deployment — used to build OAuth redirect URIs.
# In production (Vercel), set this to your exact domain (no trailing slash).
# Local dev default: http://localhost:3000
APP_URL=http://localhost:3000

# ── Scheduled posts ───────────────────────────────────────────
# Authorises GET /api/cron/publish-scheduled. Vercel Cron calls that endpoint
# with "Authorization: Bearer $CRON_SECRET" automatically once this is set on
# the project. Generate: openssl rand -hex 32
# Keep it server-side only — anyone holding it can trigger the whole queue.
CRON_SECRET=

# ── Platform developer apps ───────────────────────────────────
# Create one app per platform in its developer portal, then paste
# the credentials here. Redirect URI convention:
#   {APP_URL}/api/connect/{platform}/callback
# A platform stays "not configured" in the UI until both vars exist.

# Instagram (developers.facebook.com → Instagram API with Instagram Login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Facebook Login (developers.facebook.com)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Threads (developers.facebook.com → app with the "Access the Threads API" use case)
# A Threads app has BOTH an Instagram/Facebook app ID and a Threads app ID.
# Use the Threads pair here (App Dashboard → Settings → "Threads app ID/secret") —
# pasting the Instagram credentials causes token exchange to fail with HTTP 400.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# X / Twitter (developer.x.com — OAuth 2.0 with PKCE, confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn (developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok for Developers (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Cloud Console (OAuth consent + YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pinterest Developers (developers.pinterest.com)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Reddit (reddit.com/prefs/apps — script/web app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI providers ──────────────────────────────────────────────
# The built-in default model ("Hilbras AI" in Settings → AI Provider) is
# configured only here — users can select it but can never edit or remove it.
# Falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY below if unset.
HILBRAS_AI_API_KEY=
# Optional overrides — defaults shown:
# HILBRAS_AI_BASE_URL=https://api.openai.com/v1
# HILBRAS_AI_API_FORMAT=openai
# HILBRAS_AI_MODEL_ID=gpt-4o-mini

# Users can add their own providers in Settings → AI Provider, or set env
# vars here as a fallback when the built-in model has no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
